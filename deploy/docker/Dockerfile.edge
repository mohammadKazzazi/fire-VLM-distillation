# Edge inference container — offline fire detection
#
# Build from workspace root (/home/ubuntu/llava-test):
#   docker build -f Deploy/docker/Dockerfile.edge -t fire-detect-edge:latest .
#
# Run (mount merged bundle):
#   docker run --rm --gpus all \
#     -v $(pwd)/Deploy/bundles:/opt/fire-detect/bundles:ro \
#     -v $(pwd)/Deploy/config/students.env:/opt/fire-detect/config/students.env:ro \
#     -e HF_HUB_OFFLINE=1 -e TRANSFORMERS_OFFLINE=1 \
#     fire-detect-edge:latest \
#     --image /opt/fire-detect/samples/demo.jpg

FROM nvidia/cuda:12.1.0-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# LLaVA-MoD inference code
COPY LLaVA_MoD/MoD/LLava_MoD /opt/LLava_MoD
ENV LLAVA_MOD_ROOT=/opt/LLava_MoD
ENV PYTHONPATH=/opt/LLava_MoD:/opt/fire-detect

# Deploy package (daemon, scripts, config templates)
COPY Deploy /opt/fire-detect
WORKDIR /opt/fire-detect

RUN pip3 install --no-cache-dir \
    torch==2.1.2 torchvision==0.16.2 --index-url https://download.pytorch.org/whl/cu121 \
    && pip3 install --no-cache-dir -r /opt/LLava_MoD/requirements.txt

ENTRYPOINT ["python3", "/opt/fire-detect/fire_detect/daemon.py"]
CMD ["--help"]
