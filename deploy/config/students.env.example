# Copy of students.env.example — edit paths if needed.
# shellcheck shell=bash

STUDENT_PRESET=qwen0.5b

LLAVA_MOD_ROOT=${WORKSPACE_ROOT}/LLaVA_MoD/MoD/LLava_MoD
DEPLOY_ROOT=${WORKSPACE_ROOT}/Deploy

QWEN0_5B_LORA=${LLAVA_MOD_ROOT}/checkpoints/plan4-d2d-multiquery-v4-kd-lm-0.5b-seed42
QWEN0_5B_BASE=Qwen/Qwen2.5-0.5B-Instruct
QWEN0_5B_CONV=qwen
QWEN0_5B_BUNDLE=${DEPLOY_ROOT}/bundles/qwen2-0.5b-fire-merged

LLAMA3_1B_LORA=${LLAVA_MOD_ROOT}/checkpoints/plan4-d2d-multiquery-v4-kd-lm-llama3-1b-seed42
LLAMA3_1B_BASE=meta-llama/Llama-3.2-1B-Instruct
LLAMA3_1B_CONV=llama_3
LLAMA3_1B_BUNDLE=${DEPLOY_ROOT}/bundles/llama3-1b-fire-merged

GEMMA2_2B_LORA=${LLAVA_MOD_ROOT}/checkpoints/plan4-d2d-multiquery-v4-kd-lm-gemma2-2b-seed42
GEMMA2_2B_BASE=google/gemma-2-2b-it
GEMMA2_2B_CONV=gemma_2
GEMMA2_2B_BUNDLE=${DEPLOY_ROOT}/bundles/gemma2-2b-fire-merged

QWEN3_0_6B_LORA=${LLAVA_MOD_ROOT}/checkpoints/plan4-d2d-multiquery-v4-kd-lm-qwen3-0.6b-seed42
QWEN3_0_6B_BASE=Qwen/Qwen3-0.6B
QWEN3_0_6B_CONV=qwen3
QWEN3_0_6B_BUNDLE=${DEPLOY_ROOT}/bundles/qwen3-0.6b-fire-merged

LLAMA3_3B_LORA=${LLAVA_MOD_ROOT}/checkpoints/plan4-d2d-multiquery-v4-kd-lm-llama3-3b-seed42
LLAMA3_3B_BASE=meta-llama/Llama-3.2-3B-Instruct
LLAMA3_3B_CONV=llama_3
LLAMA3_3B_BUNDLE=${DEPLOY_ROOT}/bundles/llama3-3b-fire-merged

QWEN3_4B_LORA=${LLAVA_MOD_ROOT}/checkpoints/plan4-d2d-multiquery-v4-kd-lm-qwen3-4b-seed42
QWEN3_4B_BASE=Qwen/Qwen3-4B
QWEN3_4B_CONV=qwen3
QWEN3_4B_BUNDLE=${DEPLOY_ROOT}/bundles/qwen3-4b-fire-merged

CLIP_MODEL=openai/clip-vit-large-patch14-336

MAX_NEW_TOKENS=64
TEMPERATURE=0.0
DEVICE=cuda
LOAD_4BIT=0
LOAD_8BIT=0

HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# Runtime loads LoRA + cached base LM (same as eval). Set USE_MERGED_BUNDLE=1 to try merged dir.
USE_MERGED_BUNDLE=0
