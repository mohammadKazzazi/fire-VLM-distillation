# Deployment benchmark defaults (GPT protocol).
# Copy to benchmark.env and adjust if needed.

# Paper hardware label written into results JSON (H1, H2, H3, H4)
# HARDWARE_ID=H3

# Warm-up and measurement (per process restart)
BENCHMARK_WARMUP=20
BENCHMARK_RUNS=100
BENCHMARK_RESTARTS=3
BENCHMARK_CONCURRENCY=1

# H2 only: cap visible GPU memory (e.g. 0.5 = half L4)
# GPU_MEMORY_FRACTION=0.5
